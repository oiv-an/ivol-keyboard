<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <include
        latin:keyboardLayout="@xml/key_styles_common" />
    <include
        latin:keyboardLayout="@xml/key_styles_currency" />
    <Row
        latin:keyWidth="10%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_symbols1" />
    </Row>
    <Row
        latin:keyWidth="10%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_symbols2"
            latin:keyXPos="5%p" />
    </Row>
    <Row
        latin:keyWidth="10%p"
    >
        <Key
            latin:keyStyle="toMoreSymbolKeyStyle"
            latin:keyWidth="15%p"
            latin:visualInsetsRight="1%p" />
        <include
            latin:keyboardLayout="@xml/rowkeys_symbols3" />
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight"
            latin:visualInsetsLeft="1%p" />
    </Row>
    <Row
        latin:keyWidth="9.091%p"
    >
        <!-- IVOL: same bottom row as letters (Yandex): ABC | globe | , | space | . | enter -->
        <Key
            latin:keyStyle="toAlphaKeyStyle"
            latin:backgroundType="functional"
            latin:keyWidth="12.5%p" />
        <Key
            latin:keyStyle="languageSwitchKeyStyle"
            latin:backgroundType="functional"
            latin:keyWidth="10.3%p" />
        <Key
            latin:keySpec="!text/keyspec_comma"
            latin:keyWidth="8.3%p" />
        <Key
            latin:keyStyle="spaceKeyStyle"
            latin:keyWidth="33.2%p" />
        <Key
            latin:keySpec="!icon/shortcut_key|!code/key_shortcut"
            latin:backgroundType="functional"
            latin:keyActionFlags="noKeyPreview"
            latin:keyWidth="9.5%p" />
        <Key
            latin:keySpec="."
            latin:moreKeys="&#x2026;"
            latin:keyWidth="8.3%p" />
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
</merge>
