<!-- IVOL: bottom row like Yandex Keyboard:
     [#1?] [globe] [,] [ ‹ Language › + mic ] [.] [enter] -->
<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <Row
        latin:keyWidth="9.091%p"
    >
        <Key
            latin:keyStyle="toSymbolKeyStyle"
            latin:keyWidth="12.5%p" />
        <Key
            latin:keyStyle="languageSwitchKeyStyle"
            latin:backgroundType="functional"
            latin:keyWidth="10.3%p" />
        <Key
            latin:keySpec="!text/keyspec_comma"
            latin:keyWidth="8.3%p" />
        <Key
            latin:keyStyle="spaceKeyStyle"
            latin:keyWidth="33.2%p" />
        <Key
            latin:keySpec="!icon/shortcut_key|!code/key_shortcut"
            latin:backgroundType="functional"
            latin:keyActionFlags="noKeyPreview"
            latin:keyWidth="9.5%p" />
        <Key
            latin:keySpec="!text/keyspec_period"
            latin:moreKeys="!text/morekeys_period"
            latin:keyWidth="8.3%p" />
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
</merge>
