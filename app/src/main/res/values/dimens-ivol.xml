<?xml version="1.0" encoding="utf-8"?>
<!-- IVOL keyboard geometry, measured from Yandex Keyboard (1276px wide, 3.5 px/dp). -->
<resources>
    <dimen name="ivol_key_corner_radius">4dp</dimen>
    <dimen name="ivol_key_shadow_height">1.2dp</dimen>
    <!-- 16px of 1276px -->
    <fraction name="ivol_key_horizontal_gap">1.25%p</fraction>
    <!-- 31px of keyboard height (~4 rows x 169px + paddings) -->
    <fraction name="ivol_key_vertical_gap">4.6%p</fraction>
    <fraction name="ivol_keyboard_top_padding">0.9%p</fraction>
    <fraction name="ivol_keyboard_bottom_padding">1.3%p</fraction>
    <fraction name="ivol_keyboard_side_padding">0%p</fraction>
    <!-- Top toolbar (logo / emoji buttons at strip edges) -->
    <dimen name="ivol_toolbar_button_width">52dp</dimen>
    <dimen name="ivol_toolbar_icon_padding">12dp</dimen>
</resources>
