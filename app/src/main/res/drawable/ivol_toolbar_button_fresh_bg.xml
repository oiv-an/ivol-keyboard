<?xml version="1.0" encoding="utf-8"?>
<!-- IVOL: clipboard button lit up when something was copied a moment ago (tap = paste). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="5dp" android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <solid android:color="#9CCDEB" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="5dp" android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <solid android:color="#C1E8FF" />
            </shape>
        </inset>
    </item>
</selector>
