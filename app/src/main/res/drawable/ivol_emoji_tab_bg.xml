<?xml version="1.0" encoding="utf-8"?>
<!-- IVOL: emoji category tab background - rounded pill behind the selected category. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="4dp" android:insetRight="4dp"
            android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="#242B30" />
                <corners android:radius="10dp" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetLeft="4dp" android:insetRight="4dp"
            android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="#1E252A" />
                <corners android:radius="10dp" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
