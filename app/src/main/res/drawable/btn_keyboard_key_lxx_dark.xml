<?xml version="1.0" encoding="utf-8"?>
<!-- IVOL: letter keys + action/sticky/empty variants (Yandex dark look). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_active="true" android:state_pressed="true"
          android:drawable="@drawable/ivol_key_action_dark_pressed" />
    <item android:state_active="true"
          android:drawable="@drawable/ivol_key_action_dark" />
    <item android:state_checkable="true" android:state_checked="true" android:state_pressed="true"
          android:drawable="@drawable/ivol_key_dark_pressed" />
    <item android:state_checkable="true" android:state_pressed="true"
          android:drawable="@drawable/ivol_key_functional_dark_pressed" />
    <item android:state_checkable="true" android:state_checked="true"
          android:drawable="@drawable/ivol_key_dark_pressed" />
    <item android:state_checkable="true"
          android:drawable="@drawable/ivol_key_functional_dark" />
    <item android:state_empty="true" android:state_pressed="true"
          android:drawable="@drawable/ivol_key_dark_pressed" />
    <item android:state_empty="true"
          android:drawable="@android:color/transparent" />
    <item android:state_pressed="true"
          android:drawable="@drawable/ivol_key_dark_pressed" />
    <item android:drawable="@drawable/ivol_key_dark" />
</selector>
